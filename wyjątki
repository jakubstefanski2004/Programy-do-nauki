#include <iostream>
#include <stdexcept>

long long silnia(int n) {
    if (n < 0) {
        throw std::invalid_argument("Nieprawidlowy argument");
    }

    long long wynik = 1;
    for (int i = 1; i <= n; i++) {
        wynik *= i;
    }
    return wynik;
}

int main() {
    int n;
    std::cin >> n;

    try {
        std::cout << silnia(n);
    } catch (const std::exception&) {
        std::cout << "WYJATEK";
    }

    return 0;
}
